{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-shell",
  "description": "The shell's own pages (manager window, login.html) get every app command. No remote context here — ship-served content is covered by workspace-remote only.",
  "windows": ["workspace"],
  "permissions": [
    "allow-connect",
    "allow-local-ships",
    "allow-stack-status",
    "allow-install-grubbery",
    "core:event:default",
    "allow-connection-status",
    "allow-get-config",
    "allow-go-home",
    "allow-pick-upload",
    "allow-status",
    "allow-add-mount",
    "allow-remove-mount",
    "allow-list-mounts",
    "allow-backup-schedules",
    "allow-set-backup-schedules",
    "allow-pick-backup-dir",
    "allow-run-backup-now",
    "allow-verify-backup"
  ]
}
