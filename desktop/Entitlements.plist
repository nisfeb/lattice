<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app links macFUSE's libfuse, which macFUSE's own team signs.
	     A notarized app runs with the hardened runtime, whose library
	     validation loads only Apple's and our team's code, so without this
	     the app would not start. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
